{
  "name": "yt-summary-ai",
  "version": "4.4.1",
  "description": "AI sažetak YouTube videa",
  "scripts": {
    "package": "npm run package:ps",
    "package:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File package.ps1",
    "lint": "web-ext lint",
    "lint:js": "eslint .",
    "start": "web-ext run",
    "test": "npm run lint:js && jest"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^29.15.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "web-ext": "^10.5.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "brace-expansion": "^2.1.2",
    "shell-quote": "^1.8.5",
    "tmp": "^0.2.6"
  },
  "webExt": {
    "ignoreFiles": [
      "tests/**",
      "tmp/**",
      ".npm-cache/**",
      "coverage/**",
      "reports/**",
      "*.md",
      "docs.html",
      "package*.json",
      "*.ps1",
      "opencode.json",
      "audit-report.html"
    ]
  }
}
